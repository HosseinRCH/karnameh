# Copy to apps/api/.env and adjust as needed.
DATABASE_URL=postgresql://karnameh:karnameh@localhost:5432/karnameh?schema=public
JWT_SECRET=dev-secret-change-me
PORT=4000
CORS_ORIGIN=http://localhost:5180
WEB_APP_URL=http://localhost:5180
API_BASE_URL=http://localhost:4000

# OAuth (optional). A provider appears on the login page only when both id + secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Docker image registry for docker-compose (Docker Hub is blocked in some regions).
# Use docker.io for Docker Hub directly, or a mirror such as docker.arvancloud.ir.
DOCKER_MIRROR=docker.arvancloud.ir
